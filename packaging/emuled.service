# systemd "user" service for emuled. Installation (as a normal user, without sudo):
#   mkdir -p ~/.config/systemd/user && cp packaging/emuled.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now emuled
#   loginctl enable-linger $USER          # optional: starts at PC boot even without logging in
# Useful commands: systemctl --user status emuled | journalctl --user -u emuled -f | systemctl --user reload emuled (rechecks the shared folders)
# Expects emuled at ~/.emuled/emuled (or a link to build/emuled) and the configuration in ~/.emuled/config.yaml.
[Unit]
Description=emuled - eMule for Linux (web interface on 127.0.0.1:8765)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.emuled/emuled
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
# on shutdown the daemon saves the preferences and does the guardian's last round: give it time
TimeoutStopSec=60
KillSignal=SIGTERM
NoNewPrivileges=yes

[Install]
WantedBy=default.target
