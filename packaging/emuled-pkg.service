# systemd "user" service installed by the .deb/.rpm packages in /usr/lib/systemd/user/.
# As a normal user: emuled --install-service   (or: systemctl --user enable --now emuled; configuration in ~/.emuled/config.yaml, created at first start)
[Unit]
Description=emuled - eMule for Linux (web interface on 127.0.0.1:8765)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/emuled
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillSignal=SIGTERM
NoNewPrivileges=yes

[Install]
WantedBy=default.target
