{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client", "vitest/globals", "node"], "skipLibCheck": true,
    "paths": { "@/*": ["./src/*"] }, "noUnusedLocals": true, "noUnusedParameters": true, "isolatedModules": true, "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "templates/**/*.ts", "templates/**/*.vue", "vite.config.ts", "vitest.config.ts"]
}
